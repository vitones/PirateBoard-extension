{
  "manifest_version": 3,
  "name": "PirateBoard",
  "version": "0.0.3",
  "description": "Le os numeros do seu perfil de Sea of Thieves, mostra o que sera enviado e so envia se voce confirmar. Nao e afiliado a Rare nem a Microsoft.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://pirateboard.veetones.workers.dev/*",
    "http://127.0.0.1:8799/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.seaofthieves.com/*/profile/*"],
      "js": ["parse.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}